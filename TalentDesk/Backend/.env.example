# Copy this file to .env and fill in your own values. Never commit .env.

# Postgres (use host "postgres" instead of "localhost" inside docker-compose)
DATABASE_URL="postgresql://talentdesk:talentdesk@localhost:5432/talentdesk?schema=public"

# Redis (BullMQ queue for document ingestion)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# LLM provider (Gemini free tier works)
GOOGLE_API_KEY=""
LLM_MODEL="gemini-2.5-flash-lite"
# text-embedding-004 was retired; keep dimensions at 768 to match vector(768) in the DB.
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768

# Server
PORT=4000
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
