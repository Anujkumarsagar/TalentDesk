generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  RECRUITER
  VIEWER
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENED
  INTERVIEWED
  SELECTED
  JOINED
  REJECTED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(VIEWER)
  createdAt    DateTime      @default(now())

  stageEvents StageEvent[] @relation("StageEventChangedBy")
  documents   Document[]

  @@map("users")
}

model Job {
  id         String    @id @default(uuid())
  title      String
  clientName String
  location   String
  openings   Int       @default(1)
  status     JobStatus @default(OPEN)
  createdAt  DateTime  @default(now())

  candidates Candidate[]
  documents  Document[]

  @@index([status])
  @@map("jobs")
}

model Candidate {
  id          String         @id @default(uuid())
  name        String
  email       String         @unique
  phone       String?
  currentCtc  Decimal?       @db.Decimal(12, 2)
  expectedCtc Decimal?       @db.Decimal(12, 2)
  noticeDays  Int?
  jobId       String
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage       CandidateStage @default(APPLIED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  stageEvents StageEvent[]

  @@index([jobId])
  @@index([stage])
  @@map("candidates")
}

// Append-only audit log. The application never updates or deletes a row here.
model StageEvent {
  id          String         @id @default(uuid())
  candidateId String
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStage   CandidateStage
  toStage     CandidateStage
  changedById String
  changedBy   User           @relation("StageEventChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([candidateId])
  @@map("stage_events")
}

model Document {
  id           String         @id @default(uuid())
  filename     String         @unique
  originalName String
  mimeType     String
  size         Int
  path         String
  status       DocumentStatus @default(PENDING)
  errorMessage String?
  jobId        String?
  job          Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  chunks DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id         String    @id @default(uuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  page       Int?
  chunkIndex Int
  embedding  Unsupported("vector(768)")?

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}
